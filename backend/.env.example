# CampusBite Backend Configuration
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5175

# Authentication Mode: 'local' (offline demo / development) or 'cognito' (production AWS)
AUTH_MODE=local
JWT_SECRET=campusbite_ccl_jwt_secure_key_2026_demo
JWT_EXPIRES_IN=24h

# AWS Region & S3 Configuration (Europe Stockholm)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_ENDPOINT=

# DynamoDB Table Names
DYNAMO_TABLE_USERS=CampusBite_Users
DYNAMO_TABLE_MENU=CampusBite_Menu
DYNAMO_TABLE_ORDERS=CampusBite_Orders
DYNAMO_TABLE_TOKENS=CampusBite_Tokens
DYNAMO_TABLE_PAYMENTS=CampusBite_Payments
DYNAMO_TABLE_SUGGESTIONS=CampusBite_Suggestions
DYNAMO_TABLE_SETTINGS=CampusBite_Settings

# S3 Bucket for Food Images (Private Bucket, Stockholm eu-north-1)
S3_BUCKET_NAME=campusbite-food-images-2026

# Amazon Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# AWS Lambda Background Notification Task
LAMBDA_NOTIFICATION_FUNCTION=CampusBite_OrderNotification

# Amazon CloudWatch
CLOUDWATCH_LOG_GROUP=/campusbite/backend-api

# Owner Registration Authorization Code
OWNER_REGISTRATION_CODE=CAMPUS-OWNER-2026
